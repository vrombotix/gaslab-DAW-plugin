{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI DAW Prototype",
  "version": "0.1.0",
  "identifier": "dev.aidaw.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "AI DAW Prototype",
      "width": 1180,
      "height": 820,
      "minWidth": 900,
      "minHeight": 680
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/daw-agent"],
    "icon": ["icons/icon.png"],
    "macOS": { "minimumSystemVersion": "10.15" },
    "resources": {
      "../../../integrations": "integrations"
    }
  }
}
